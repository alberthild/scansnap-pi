# Copy to ~/.config/scansnap/scansnap.env and set mode 600.
# Obtain the exact device identifier with: scanimage -L
SCANNER_DEVICE="fujitsu:ScanSnap iX500:replace-with-your-device-id"

# ownCloud example:
# https://cloud.example.com/remote.php/webdav/Scans/
# Nextcloud example:
# https://cloud.example.com/remote.php/dav/files/username/Scans/
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/username/Scans/
WEBDAV_USER=username
WEBDAV_PASSWORD=replace-with-an-app-password

# Optional scan settings:
# RESOLUTION=200
# BLANK_THRESHOLD=0.96
# JPEG_QUALITY=60
